# Supabase → Project Settings → Data API / API Keys
SUPABASE_URL=
# Secret key (sb_secret_...). Relay only — never in the dashboard or the Pi.
SUPABASE_SECRET_KEY=
# Shared with the Pi. Generate with: openssl rand -hex 32
DUCK_TOKEN=
RELAY_PORT=8080
# ElevenLabs (the duck's voice). The relay proxies TTS so the key never leaves the laptop.
ELEVENLABS_API_KEY=
# The duck's voice: ElevenLabs → Voices → (your voice) → copy the voice ID
ELEVENLABS_VOICE_ID=
# Optional; default eleven_flash_v2_5 (lowest latency)
ELEVENLABS_MODEL_ID=
# Anthropic (the coach's lock-in lines). Optional: without it the Pi uses built-in templates.
ANTHROPIC_API_KEY=
# Optional; default claude-haiku-5-5 (fast + cheap for one-liners)
ANTHROPIC_MODEL=
# Optional; only if you go through a proxy (default https://api.anthropic.com)
ANTHROPIC_BASE_URL=
# Live camera view on the dashboard. Empty = any logged-in user the duck is with.
# Comma-separated emails = only those accounts. off = disabled. Frames are never stored.
VIDEO_VIEWERS=
# Optional; frames per second for the live view (1-15, default 6)
VIDEO_FPS=
# Google Calendar via Auth0 (Calendar tab -> Connect Google Calendar). See backend/CLAUDE.md for the setup.
# Auth0 Regular Web App: domain + client id/secret. The same app must be authorized for the
# Auth0 Management API with read:users and read:user_idp_tokens.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# The Google OAuth client you gave Auth0's Google connection (lets the relay refresh expired Google tokens)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the browser can reach this relay (Auth0 callback = <this>/auth/google/callback) and the dashboard
RELAY_PUBLIC_URL=http://192.168.1.67:8080
DASHBOARD_URL=http://192.168.1.67:3000
