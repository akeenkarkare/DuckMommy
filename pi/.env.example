# Same value as backend DUCK_TOKEN
DUCK_TOKEN=
# Relay on the laptop, e.g. ws://<laptop-ip>:8080 (TTS goes through http://<same>/tts)
RELAY_URL=

# Hardware (BCM pin numbers; leave blank if not wired)
ULTRASONIC_TRIG=
ULTRASONIC_ECHO=
# Pressure sensor digital output (e.g. FSR comparator module). PRESS_ACTIVE=high or low
PRESS_PIN=
PRESS_ACTIVE=high
# Alert LED (through a 330 Ω resistor)
LED_PIN=
# USB microphone, from `arecord -l`, e.g. plughw:CARD=Device,DEV=0
MIC_DEVICE=default
# Optional: fixed key for `duck.py --preview` (otherwise a new random one each run)
PREVIEW_KEY=
